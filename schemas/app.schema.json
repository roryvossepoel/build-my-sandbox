{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://windows-sandbox-builder/schemas/app.schema.json",
  "title": "Windows Sandbox Builder application manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "install", "detection"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "publisher": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "category": {
      "type": "string",
      "enum": ["packaging", "troubleshooting", "development", "runtime", "utilities", "security", "windows"]
    },
    "architectures": {
      "type": "array",
      "items": { "enum": ["x64", "arm64", "x86"] },
      "uniqueItems": true,
      "default": ["x64"]
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "enum": ["exe", "msi", "zip", "portable", "script"] },
        "url": { "type": "string", "format": "uri" },
        "fileName": { "type": "string" },
        "silentArgs": { "type": "string" },
        "extractTo": { "type": "string" },
        "postInstall": { "type": "array", "items": { "type": "string" } }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["file", "registry", "command"] },
        "value": { "type": "string" }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": { "type": "string" },
        "badge": { "type": "string" },
        "recommended": { "type": "boolean" }
      }
    }
  }
}
