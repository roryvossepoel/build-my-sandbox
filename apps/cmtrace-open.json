{
  "$schema": "../schemas/app.schema.json",
  "id": "cmtrace-open",
  "name": "CMTrace Open",
  "description": "Modern CMTrace-inspired log viewer for Windows troubleshooting.",
  "publisher": "Adam Gell",
  "homepage": "https://cmtrace.dev",
  "category": "troubleshooting",
  "architectures": ["x64"],
  "dependencies": ["webview2"],
  "install": {
    "type": "portable",
    "url": "https://win.cmtrace.net",
    "fileName": "CMTraceOpen.exe",
    "extractTo": "C:\\SandboxToolbox\\Tools\\CMTraceOpen"
  },
  "detection": {
    "type": "file",
    "value": "C:\\SandboxToolbox\\Tools\\CMTraceOpen\\CMTraceOpen.exe"
  },
  "actions": [
    {
      "name": "CMTrace Open",
      "type": "app",
      "path": "C:\\SandboxToolbox\\Tools\\CMTraceOpen\\CMTraceOpen.exe"
    },
    {
      "name": "Open Build My Sandbox log",
      "type": "app",
      "path": "C:\\SandboxToolbox\\Tools\\CMTraceOpen\\CMTraceOpen.exe",
      "arguments": "C:\\SandboxToolbox\\Logs\\BuildMySandbox.log"
    },
    {
      "name": "Open Logs folder",
      "type": "folder",
      "path": "C:\\SandboxToolbox\\Logs"
    }
  ],
  "ui": { "recommended": true }
}
