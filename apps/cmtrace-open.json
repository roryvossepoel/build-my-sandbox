    "fileName": "CMTraceOpen.exe",
    "extractTo": "C:\\SandboxToolbox\\Tools\\CMTraceOpen"
  },
  "detection": {
    "type": "file",
    "value": "C:\\SandboxToolbox\\Tools\\CMTraceOpen\\CMTraceOpen.exe"
  },
  "ui": { "recommended": true }
}
