{
  "$schema": "../schemas/app.schema.json",
  "id": "cmtrace-classic",
  "name": "CMTrace Classic",
  "description": "Classic CMTrace log viewer for Configuration Manager and Intune troubleshooting.",
  "publisher": "Microsoft",
  "homepage": "https://learn.microsoft.com/intune/configmgr/core/support/cmtrace",
  "category": "troubleshooting",
  "architectures": ["x64"],
  "dependencies": [],
  "install": {
    "type": "portable",
    "url": "https://patchmypc.com/cmtrace",
    "fileName": "cmtrace.exe",
    "extractTo": "C:\\SandboxToolbox\\Tools\\CMTraceClassic"
  },
  "detection": {
    "type": "file",
    "value": "C:\\SandboxToolbox\\Tools\\CMTraceClassic\\cmtrace.exe"
  },
  "actions": [
    {
      "name": "CMTrace Classic",
      "type": "app",
      "path": "C:\\SandboxToolbox\\Tools\\CMTraceClassic\\cmtrace.exe"
    },
    {
      "name": "Open Build My Sandbox log in CMTrace",
      "type": "app",
      "path": "C:\\SandboxToolbox\\Tools\\CMTraceClassic\\cmtrace.exe",
      "arguments": "C:\\SandboxToolbox\\Logs\\BuildMySandbox.log"
    },
    {
      "name": "Open Logs folder",
      "type": "folder",
      "path": "C:\\SandboxToolbox\\Logs"
    }
  ],
  "ui": { "recommended": true }
}
